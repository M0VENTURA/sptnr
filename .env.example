# =============================================================================
# Popularr — Environment Variables
# =============================================================================
# Copy this file to .env and edit the values to match your setup.
#   cp .env.example .env
# Then start with: docker compose up -d
#
# All settings shown here can also be configured via the web UI
# (Config page) after first-run setup.

# --- PostgreSQL (required) ---
# The app uses PostgreSQL exclusively.  Set these before first run.
PG_HOST=postgres-sptnr
PG_PORT=5432
PG_USER=popularr
PG_PASSWORD=popularr
PG_DATABASE=popularr

# --- Navidrome (required) ---
# These populate the first navidrome user during setup.
# If not set, use the Setup Wizard at first run.
# POPULARLR_NAV_URL=http://navidrome:4533
# POPULARLR_NAV_USER=admin
# POPULARLR_NAV_PASS=yourpassword

# --- API Keys (optional — add later in Config page) ---
# POPULARLR_LASTFM_API_KEY=
# POPULARLR_DISCOGS_TOKEN=
# POPULARLR_AUDIODB_API_KEY=

# --- Downloads ---
# POPULARLR_DOWNLOADS_FOLDER=/downloads

# --- Automation / Watcher ---
# POPULARLR_AUTO_IMPORT=true
# POPULARLR_AUTO_POPULARITY_SCAN=true
# POPULARLR_SCAN_INTERVAL=30

# --- Essentia ML (mood/genre analysis) ---
# POPULARLR_ESSENTIA_ENABLED=false
# POPULARLR_ESSENTIA_MODELS_DIR=/opt/essentia_models
# POPULARLR_ESSENTIA_SCRIPT_PATH=/opt/Essentia-to-Metadata/tag_music.py

# --- Paths ---
MUSIC_ROOT=/path/to/your/music
DOWNLOADS_DIR=/path/to/your/downloads

# --- Application ---
TZ=Australia/Melbourne
LOG_LEVEL=info
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300
QUEUE_INTERVAL=30
