# =============================================================================
# Popularr — Environment Variables (copy to .env and adjust)
# =============================================================================
# Copy this file to .env and edit the values to match your setup.
#   cp .env.example .env
# Then start with: docker compose up -d

# --- Database ---
PG_USER=popularr
PG_PASSWORD=popularr
PG_DATABASE=popularr
# PG_PORT_EXTERNAL=127.0.0.1:5432   # uncomment to expose DB on localhost

# --- Paths ---
# Music library (read-only by the container)
MUSIC_ROOT=/path/to/your/music
# Downloads folder (read-write)
DOWNLOADS_DIR=/path/to/your/downloads
# Optional: pre-downloaded Essentia models to avoid re-downloading
# ESSENTIA_MODELS_DIR=./essentia_models

# --- Application ---
TZ=Australia/Melbourne
LOG_LEVEL=info
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300
QUEUE_INTERVAL=30
