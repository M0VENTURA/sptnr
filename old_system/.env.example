# Navidrome integration
NAV_BASE_URL=
NAV_USER=
NAV_PASS=

# Disable automatic Navidrome import on application startup (set to "1" to disable)
# Can also be configured in config.yaml under features.auto_boot_navidrome_scan
# SPTNR_DISABLE_BOOT_ND_IMPORT=0

# Last.fm API credentials
LASTFM_API_KEY=
LASTFM_API_SECRET=

# Discogs personal access token (https://www.discogs.com/settings/developers)
DISCOGS_TOKEN=

# Music folder path (for MP3 metadata scanning)
MUSIC_FOLDER=/music

# Weighting — lastfm + listenbrainz + age should sum to 1.0
LASTFM_WEIGHT=0.55
AGE_WEIGHT=0.10

